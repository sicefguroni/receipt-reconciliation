# Copy to .env. Every variable has a working default except OPENAI_API_KEY,
# which is only needed when MODE=live.

# --- Model (OpenAI Responses API) ------------------------------------------
# replay: serve recorded responses from fixtures/recordings (no API key needed)
# live:   call the OpenAI API
MODE=replay
# Set to 1 in live mode to record responses into fixtures/recordings
RECORD=0
OPENAI_API_KEY=
# Same model as baseline B1 runs 2-3, so the B1 comparison holds the model constant.
MODEL_EXTRACT=gpt-5.6-sol
MODEL_CATEGORISE=gpt-5.6-sol
# none | minimal | low | medium | high
MODEL_REASONING_EFFORT=low

# --- FX rates (Frankfurter, ECB reference rates, no key) -------------------
# Verified 2026-11-03: GET {FX_BASE_URL}/{from}..{to}?base=USD&symbols=AUD
FX_BASE_URL=https://api.frankfurter.dev/v1

# --- Storage ---------------------------------------------------------------
DATABASE_PATH=./data/app.db
FILE_STORE_DIR=./data/files

# --- Policy thresholds (docs/sprint/05-business-rules.md) -----------------
# R-AMT-2 (confirmed 2026-11-02): flag when the difference is over PCT % OR over AUD.
# The finance lead owns the policy, so both stay configurable.
AMOUNT_DIFF_PCT_THRESHOLD=10
AMOUNT_DIFF_AUD_THRESHOLD=100
# R-MAT-1: auto-match only if best score >= MIN_SCORE and beats runner-up by >= MIN_MARGIN
AUTO_MATCH_MIN_SCORE=75
AUTO_MATCH_MIN_MARGIN=20
# R-MAT-9 (Day 4): a statement line further than this many days from the receipt date is
# not a candidate. Tuned on the tuning split (posting lag 0-2 days); weekends and holidays fit.
MATCH_MAX_DAYS_APART=7
# Extraction field confidence below this flags LOW_CONFIDENCE_FIELD
EXTRACT_CONFIDENCE_MIN=0.8
# R-CAT-2: model category confidence below this flags UNKNOWN_CATEGORY
CATEGORY_CONFIDENCE_MIN=0.7
# R-QUA-1: CONFIRM WITH USER. Orientation-aware minimum photo size in px.
QUALITY_MIN_LONG_SIDE=1000
QUALITY_MIN_SHORT_SIDE=700
